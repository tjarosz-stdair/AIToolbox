@model EmbedChatViewModel
@{
    ViewData["Title"] = "Chat";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Chat</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/embed-chat.css" asp-append-version="true" />
</head>
<body>
    <div
        data-embed-chat
        data-parent-origin="@Model.ExpectedParentOrigin"
        data-max-message-length="@Model.MaxMessageLength"
        data-preferred-width="@Model.PreferredWidth"
        data-speech-enabled="@Model.SpeechEnabled.ToString().ToLowerInvariant()"
        class="embed-root">

        <div class="embed-header">
            <div class="embed-context-chip" data-context-chip>Connecting&hellip;</div>
            <div class="embed-surface-pills" data-surface-pills></div>
        </div>

        <div class="embed-banner" data-status-banner hidden></div>

        <div class="embed-resume-banner" data-resume-banner hidden>
            <span data-resume-banner-text></span>
            <button type="button" class="embed-resume-banner-button" data-resume-banner-reset>Start new</button>
        </div>

        <div class="embed-transcript" data-transcript></div>

        <div class="embed-auto-navigate" data-auto-navigate-row hidden>
            <label>
                <input type="checkbox" data-auto-navigate-checkbox checked />
                Auto-navigate PIC Search
            </label>
            <button type="button" class="embed-reset-button" data-reset-button>Reset conversation</button>
        </div>

        <form class="embed-composer" data-composer-form>
            <input
                type="text"
                class="embed-composer-input"
                data-composer-input
                maxlength="@Model.MaxMessageLength"
                placeholder="Ask a question&hellip;"
                disabled
                autocomplete="off" />
            <button type="button" class="embed-mic-button" data-mic-button aria-label="Voice input" disabled hidden>
                <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true">
                    <path d="M12 14a3 3 0 0 0 3-3V6a3 3 0 0 0-6 0v5a3 3 0 0 0 3 3z" />
                    <path d="M19 11a1 1 0 0 0-2 0 5 5 0 0 1-10 0 1 1 0 0 0-2 0 7 7 0 0 0 6 6.92V20H9a1 1 0 0 0 0 2h6a1 1 0 0 0 0-2h-2v-2.08A7 7 0 0 0 19 11z" />
                </svg>
            </button>
            <button type="submit" class="embed-composer-button" data-composer-button disabled>Send</button>
        </form>
    </div>

    <script src="~/js/embed-chat.js" asp-append-version="true"></script>
</body>
</html>
