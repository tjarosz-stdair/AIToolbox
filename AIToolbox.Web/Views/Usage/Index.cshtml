@model UsageIndexViewModel

@{
    ViewData["Title"] = "Usage";
}

<div class="page-heading">
    <div>
        <h1>Usage</h1>
        <p class="text-muted mb-0">Review tool activity and maintain model pricing for estimated costs.</p>
    </div>
</div>

@if (TempData["StatusMessage"] is string statusMessage)
{
    <div class="alert alert-success">@statusMessage</div>
}

<form method="get" class="tool-surface mb-3">
    <div class="row g-3 align-items-end">
        <div class="col-md-5">
            <label class="form-label" for="userEmail">User email</label>
            <input id="userEmail" name="userEmail" value="@Model.UserEmail" class="form-control" />
        </div>
        <div class="col-md-4">
            <label class="form-label" for="toolKey">Tool key</label>
            <input id="toolKey" name="toolKey" value="@Model.ToolKey" class="form-control" />
        </div>
        <div class="col-md-3">
            <button type="submit" class="btn btn-primary w-100">Filter</button>
        </div>
    </div>
</form>

<div class="table-surface mb-3">
    <table class="table align-middle mb-0">
        <thead>
            <tr>
                <th>When</th>
                <th>User</th>
                <th>Tool</th>
                <th>Tokens</th>
                <th>Cost</th>
                <th>Status</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var item in Model.Usage)
        {
            <tr>
                <td>@item.CreatedUtc.ToLocalTime().ToString("g")</td>
                <td>@item.UserEmail</td>
                <td>@item.ToolKey / @item.RequestType</td>
                <td>@item.TokensIn in / @item.TokensOut out</td>
                <td>@(item.EstimatedCostUsd?.ToString("C4") ?? "n/a")</td>
                <td>@(item.Succeeded ? "Succeeded" : item.ErrorMessage)</td>
            </tr>
        }
        </tbody>
    </table>
</div>

<section class="tool-surface">
    <h2>Model pricing</h2>
    <form asp-action="AddPricing" method="post" class="row g-3 align-items-end mb-3">
        @Html.AntiForgeryToken()
        <div class="col-md-3">
            <label class="form-label" for="ProviderType">Provider type</label>
            <select id="ProviderType" name="ProviderType" asp-items="Html.GetEnumSelectList<AiProviderType>()" class="form-select"></select>
        </div>
        <div class="col-md-3">
            <label class="form-label" for="ModelName">Model</label>
            <input id="ModelName" name="ModelName" class="form-control" />
        </div>
        <div class="col-md-2">
            <label class="form-label" for="InputPricePer1kUsd">Input / 1k</label>
            <input id="InputPricePer1kUsd" name="InputPricePer1kUsd" class="form-control" type="number" step="0.000001" />
        </div>
        <div class="col-md-2">
            <label class="form-label" for="OutputPricePer1kUsd">Output / 1k</label>
            <input id="OutputPricePer1kUsd" name="OutputPricePer1kUsd" class="form-control" type="number" step="0.000001" />
        </div>
        <div class="col-md-2">
            <button type="submit" class="btn btn-outline-primary w-100">Save</button>
        </div>
    </form>
    <div class="table-surface">
        <table class="table align-middle mb-0">
            <thead>
                <tr>
                    <th>Provider</th>
                    <th>Model</th>
                    <th>Input</th>
                    <th>Output</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var price in Model.Pricing)
            {
                <tr>
                    <td>@price.ProviderType</td>
                    <td>@price.ModelName</td>
                    <td>@price.InputPricePer1kUsd</td>
                    <td>@price.OutputPricePer1kUsd</td>
                    <td>@(price.IsActive ? "Active" : "Inactive")</td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</section>
