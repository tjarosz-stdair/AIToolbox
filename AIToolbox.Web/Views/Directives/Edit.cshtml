@model DirectiveEditViewModel

@{
    ViewData["Title"] = Model.Id == 0 ? "Add Directive" : "Edit Directive";
}

<div class="page-heading">
    <div>
        <h1>@ViewData["Title"]</h1>
        <p class="text-muted mb-0">The system prompt should require valid JSON matching the target schema.</p>
    </div>
</div>

@if (TempData["StatusMessage"] is string statusMessage)
{
    <div class="alert alert-success">@statusMessage</div>
}

<form asp-action="Edit" asp-route-id="@Model.Id" method="post" class="tool-surface">
    @Html.AntiForgeryToken()
    <input asp-for="Id" type="hidden" />
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="form-grid">
        <div class="mb-3">
            <label asp-for="ToolKey" class="form-label"></label>
            <input asp-for="ToolKey" class="form-control" />
        </div>
        <div class="mb-3">
            <label asp-for="Name" class="form-label"></label>
            <input asp-for="Name" class="form-control" />
        </div>
        <div class="mb-3">
            <label asp-for="Version" class="form-label"></label>
            <input asp-for="Version" class="form-control" type="number" />
        </div>
        <div class="mb-3 form-check form-switch align-self-end">
            <input asp-for="IsActive" class="form-check-input" />
            <label asp-for="IsActive" class="form-check-label">Active</label>
        </div>
        <div class="mb-3 wide">
            <label asp-for="SystemPrompt" class="form-label"></label>
            <textarea asp-for="SystemPrompt" class="form-control code-box" rows="8"></textarea>
        </div>
        <div class="mb-3 wide">
            <label asp-for="TargetSchemaJson" class="form-label"></label>
            <textarea asp-for="TargetSchemaJson" class="form-control code-box" rows="10"></textarea>
        </div>
    </div>
    <div class="form-actions">
        <a asp-action="Index" class="btn btn-outline-secondary">Back</a>
        <button type="submit" class="btn btn-primary">Save directive</button>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
