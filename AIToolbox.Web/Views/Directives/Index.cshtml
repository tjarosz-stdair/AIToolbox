@model IReadOnlyList<ToolDirective>

@{
    ViewData["Title"] = "Directives";
}

<div class="page-heading">
    <div>
        <h1>Directives</h1>
        <p class="text-muted mb-0">Manage prompts and schemas that guide tool output.</p>
    </div>
    <div class="page-actions">
        <a asp-action="Create" class="btn btn-primary">Add directive</a>
    </div>
</div>

<div class="table-surface">
    <table class="table align-middle mb-0">
        <thead>
            <tr>
                <th>Name</th>
                <th>Tool</th>
                <th>Version</th>
                <th>Status</th>
                <th class="text-end">Actions</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var directive in Model)
        {
            <tr>
                <td>@directive.Name</td>
                <td>@directive.ToolKey</td>
                <td>@directive.Version</td>
                <td>@(directive.IsActive ? "Active" : "Inactive")</td>
                <td class="text-end">
                    <a asp-action="Edit" asp-route-id="@directive.Id" class="btn btn-sm btn-outline-primary">Edit</a>
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>
