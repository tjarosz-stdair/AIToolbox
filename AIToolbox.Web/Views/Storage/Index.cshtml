@model StorageIndexViewModel

@{
    ViewData["Title"] = "Storage";
}

<div class="page-heading">
    <div>
        <h1>Storage</h1>
        <p class="text-muted mb-0">Effective project file storage configuration.</p>
    </div>
</div>

<section class="tool-surface">
    <dl class="access-details">
        <dt>Base path</dt>
        <dd>@(string.IsNullOrWhiteSpace(Model.BasePath) ? "Not configured" : Model.BasePath)</dd>
        <dt>Max upload bytes</dt>
        <dd>@Model.MaxUploadBytes.ToString("N0")</dd>
    </dl>

    <h2 class="mt-3">Tool subpaths</h2>
    <div class="table-surface">
        <table class="table align-middle mb-0">
            <thead>
                <tr>
                    <th>Tool</th>
                    <th>Subpath</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var item in Model.ToolSubpaths)
            {
                <tr>
                    <td>@item.Key</td>
                    <td>@item.Value</td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</section>
