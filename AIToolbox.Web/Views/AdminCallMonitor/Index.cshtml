@using AIToolbox.Web.Services.CallEntityExtraction
@model IReadOnlyList<ActiveCallSummary>
@{
    ViewData["Title"] = "Live Call Monitor";
}
@functions {
    // Mirrors the client-side formatDuration() in the script below -- keep the two in sync.
    private static string FormatDuration(TimeSpan elapsed)
    {
        elapsed = elapsed < TimeSpan.Zero ? TimeSpan.Zero : elapsed;
        return elapsed.TotalHours >= 1
            ? elapsed.ToString(@"h\:mm\:ss")
            : elapsed.ToString(@"m\:ss");
    }
}

<div class="page-heading">
    <div>
        <h1>Live Call Monitor</h1>
        <p class="text-muted mb-0">
            Real-time transcript and AI-detected entity prompts for active RingCX calls, in place
            of impersonating an agent's Caller Tray session.
        </p>
    </div>
</div>

<div class="override-layout">
    <div class="override-panel">
        <h2 class="h6 text-muted">AI Prompt Testing Overrides</h2>
        <p class="text-muted small mb-2">
            Force the ingestion and/or delivery stages to run for an agent whose real opt-in is off,
            without changing that agent's real experience on live calls. Both overrides
            auto-expire and are ignored entirely once the agent's real opt-in is on.
        </p>
        <div class="override-row">
            <label class="text-muted small" for="override-agent-key">Agent key</label>
            <input type="text" id="override-agent-key" placeholder="domain:username" />
            <button type="button" id="override-check">Check status</button>
        </div>
        <div id="override-status" class="text-muted small mb-2">Enter an agent key and check status.</div>
        <div class="override-controls">
            <div class="override-control">
                <strong>Ingestion override</strong>
                <span class="text-muted small d-block">Runs capture/transcription silently — no card reaches the Tray.</span>
                <select id="override-ingestion-minutes">
                    <option value="15">15 min</option>
                    <option value="30">30 min</option>
                    <option value="60" selected>60 min</option>
                    <option value="120">120 min</option>
                </select>
                <button type="button" id="override-ingestion-enable">Enable</button>
                <button type="button" id="override-ingestion-clear">Clear</button>
            </div>
            <div class="override-control">
                <strong>Delivery override</strong>
                <span class="text-muted small d-block">Additionally lets a generated card reach the Tray.</span>
                <select id="override-delivery-minutes">
                    <option value="15">15 min</option>
                    <option value="30">30 min</option>
                    <option value="60" selected>60 min</option>
                    <option value="120">120 min</option>
                </select>
                <input type="text" id="override-delivery-mirror" placeholder="Mirror to agent key (optional)" class="form-control form-control-sm mt-1" />
                <span class="text-muted small d-block mt-1">
                    Leave blank to deliver to this agent. Set to also (or, while this agent's real
                    opt-in is off, instead) send the card to a different agent's Tray — e.g. your
                    own, to watch this agent's calls without opting them in for real. If this
                    agent's real opt-in is (or becomes) ON, both this agent and the mirror target
                    get it.
                </span>
                <button type="button" id="override-delivery-enable" class="mt-1">Enable</button>
                <button type="button" id="override-delivery-clear">Clear</button>
            </div>
        </div>
    </div>

    <div class="active-overrides-panel">
        <div class="active-overrides-header">
            <h2 class="h6 text-muted mb-0">Active Overrides</h2>
            <div class="active-overrides-header-controls">
                <select id="active-overrides-interval" title="Auto-refresh interval">
                    <option value="0">Off</option>
                    <option value="5000">5s</option>
                    <option value="10000">10s</option>
                    <option value="15000">15s</option>
                    <option value="30000" selected>30s</option>
                    <option value="60000">60s</option>
                </select>
                <button type="button" id="active-overrides-refresh">Refresh</button>
            </div>
        </div>
        <div id="active-overrides-list" class="text-muted small">Loading…</div>
    </div>
</div>

<div class="call-monitor-layout">
    <div class="call-monitor-list">
        <h2 class="h6 text-muted">Active calls</h2>
        <div id="active-calls" data-empty-text="No active calls right now.">
            @if (Model.Count == 0)
            {
                <p class="text-muted small" data-empty-row>No active calls right now.</p>
            }
            else
            {
                foreach (var call in Model)
                {
                    var duration = FormatDuration((call.EndedAtUtc ?? DateTime.UtcNow) - call.StartedAtUtc);
                    <button type="button" class="call-row@(call.EndedAtUtc.HasValue ? " ended" : "")" data-call-id="@call.CallId" data-agent-key="@call.AgentKey" data-started-at="@call.StartedAtUtc.ToString("o")">
                        <strong>@(string.IsNullOrWhiteSpace(call.AgentKey) ? "(unknown agent)" : call.AgentKey)</strong>
                        @if (call.EndedAtUtc.HasValue)
                        {
                            <span class="ov-badge ov-badge-off call-ended-badge">Ended</span>
                        }
                        <span class="text-muted small d-block">@call.CallId</span>
                        @* data-started-at/data-last-activity carry the raw UTC instant; script hydrates
                           these labels to the viewer's local time on load -- a plain UTC ISO string here
                           reads as noise and is easy to miss (it's just "Z"-suffixed digits). *@
                        <span class="text-muted small d-block">
                            Started <span data-started-label></span> · <span data-duration>@duration</span>
                        </span>
                        <span class="text-muted small d-block" data-last-activity="@call.LastActivityUtc.ToString("o")"></span>
                    </button>
                }
            }
        </div>
    </div>

    <div class="call-monitor-detail">
        <div id="no-call-selected" class="text-muted">Select an active call to watch it.</div>

        <div id="call-detail" hidden>
            <h2 class="h5" id="call-detail-heading"></h2>
            <div class="text-muted small mb-2" id="call-detail-meta"></div>

            <div class="call-monitor-columns">
                <div>
                    <h3 class="h6 text-muted">Transcript</h3>
                    <div id="transcript-lines" class="call-monitor-transcript"></div>
                </div>
                <div>
                    <h3 class="h6 text-muted">Detected prompts</h3>
                    <div id="entity-cards" class="call-monitor-entities"></div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .override-layout {
        display: grid;
        grid-template-columns: 1fr 380px;
        gap: 1.5rem;
        align-items: start;
        margin-bottom: 1.5rem;
    }

    .override-panel {
        border: 1px solid var(--bs-border-color, #dee2e6);
        border-radius: 0.5rem;
        padding: 0.75rem 1rem;
    }

    .active-overrides-panel {
        border: 1px solid var(--bs-border-color, #dee2e6);
        border-radius: 0.5rem;
        padding: 0.75rem 1rem;
        max-height: 420px;
        overflow-y: auto;
    }

    .active-overrides-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 0.5rem;
    }

    .active-overrides-header-controls {
        display: flex;
        align-items: center;
        gap: 0.4rem;
    }

    .active-overrides-header-controls select,
    .active-overrides-header-controls button {
        font-size: 0.8rem;
    }

    .active-override-row {
        border: 1px solid var(--bs-border-color, #dee2e6);
        border-radius: 0.375rem;
        padding: 0.4rem 0.6rem;
        margin-bottom: 0.5rem;
    }

    .active-override-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 0.5rem;
    }

    .active-override-header strong {
        overflow-wrap: anywhere;
    }

    .active-override-header button {
        flex: 0 0 auto;
        font-size: 0.75rem;
    }

    .ov-line {
        display: flex;
        align-items: baseline;
        gap: 0.45rem;
        margin-top: 0.3rem;
        font-size: 0.8rem;
    }

    .ov-badge {
        display: inline-block;
        flex: 0 0 auto;
        border-radius: 0.25rem;
        padding: 0.05rem 0.45rem;
        font-size: 0.7rem;
        font-weight: 600;
        white-space: nowrap;
    }

    .ov-badge-on {
        background-color: #d1e7dd;
        color: #0f5132;
    }

    .ov-badge-off {
        background-color: #e2e3e5;
        color: #41464b;
    }

    .ov-expiry {
        color: var(--bs-secondary-color, #6c757d);
        font-variant-numeric: tabular-nums;
        white-space: nowrap;
    }

    .ov-mirror {
        margin-top: 0.15rem;
        margin-left: calc(0.7rem + 0.45rem);
        font-style: italic;
        color: var(--bs-secondary-color, #6c757d);
    }

    .override-row {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        margin-bottom: 0.5rem;
    }

    .override-row input[type="text"] {
        flex: 0 0 260px;
    }

    .override-controls {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1rem;
    }

    .override-control {
        border: 1px solid var(--bs-border-color, #dee2e6);
        border-radius: 0.375rem;
        padding: 0.5rem 0.75rem;
    }

    .override-control select {
        margin: 0.4rem 0.4rem 0.4rem 0;
    }

    .call-monitor-layout {
        display: grid;
        grid-template-columns: 280px 1fr;
        gap: 1.5rem;
        align-items: start;
    }

    .call-monitor-list {
        border: 1px solid var(--bs-border-color, #dee2e6);
        border-radius: 0.5rem;
        padding: 0.75rem;
    }

    .call-row {
        display: block;
        width: 100%;
        text-align: left;
        background: none;
        border: 1px solid transparent;
        border-radius: 0.375rem;
        padding: 0.5rem 0.6rem;
        margin-bottom: 0.25rem;
        cursor: pointer;
    }

    .call-row:hover {
        background-color: var(--bs-tertiary-bg, #f8f9fa);
    }

    .call-row.selected {
        border-color: var(--bs-primary, #0d6efd);
        background-color: var(--bs-tertiary-bg, #f8f9fa);
    }

    .call-row.ended {
        opacity: 0.65;
    }

    .call-ended-badge {
        margin-left: 0.4rem;
    }

    #call-detail-heading .call-ended-badge {
        margin-left: 0.6rem;
        vertical-align: middle;
    }

    .call-monitor-detail {
        border: 1px solid var(--bs-border-color, #dee2e6);
        border-radius: 0.5rem;
        padding: 1rem;
        min-height: 200px;
    }

    .call-monitor-columns {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1.5rem;
    }

    .call-monitor-transcript {
        max-height: 480px;
        overflow-y: auto;
        border: 1px solid var(--bs-border-color, #dee2e6);
        border-radius: 0.375rem;
        padding: 0.5rem 0.75rem;
    }

    .transcript-line {
        margin-bottom: 0.4rem;
    }

    .transcript-line-time {
        display: inline-block;
        min-width: 3rem;
        font-variant-numeric: tabular-nums;
        color: var(--bs-secondary-color, #6c757d);
        font-size: 0.8rem;
        margin-right: 0.35rem;
    }

    .side-badge {
        display: inline-block;
        min-width: 3.5rem;
        text-align: center;
        border-radius: 0.25rem;
        padding: 0 0.35rem;
        font-size: 0.75rem;
        font-weight: 600;
        margin-right: 0.4rem;
    }

    .side-badge.side-agent {
        background-color: #cfe2ff;
        color: #084298;
    }

    .side-badge.side-external {
        background-color: #fff3cd;
        color: #664d03;
    }

    .call-monitor-entities {
        max-height: 480px;
        overflow-y: auto;
    }

    .entity-card {
        border: 1px solid var(--bs-border-color, #dee2e6);
        border-left: 4px solid var(--bs-primary, #0d6efd);
        border-radius: 0.375rem;
        padding: 0.6rem 0.75rem;
        margin-bottom: 0.5rem;
    }

    .entity-card .actions {
        margin-top: 0.4rem;
    }

    .entity-card .actions span {
        display: inline-block;
        border: 1px solid var(--bs-border-color, #dee2e6);
        border-radius: 0.25rem;
        padding: 0.1rem 0.5rem;
        margin-right: 0.3rem;
        font-size: 0.8rem;
    }
</style>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/@@microsoft/signalr@latest/dist/browser/signalr.min.js"></script>
    <script>
        (function () {
            const activeCallsEl = document.getElementById('active-calls');
            const noCallSelectedEl = document.getElementById('no-call-selected');
            const callDetailEl = document.getElementById('call-detail');
            const callDetailHeadingEl = document.getElementById('call-detail-heading');
            const callDetailMetaEl = document.getElementById('call-detail-meta');
            const transcriptEl = document.getElementById('transcript-lines');
            const entitiesEl = document.getElementById('entity-cards');

            let selectedCallId = null;
            const endedCallIds = new Set();

            const entityTypeLabels = {
                model_number: 'Model Number',
                serial_number: 'Serial Number',
                part_number: 'Part Number',
                order_number: 'Order Number',
                purchase_order_number: 'Purchase Order Number',
                job_name: 'Job Name'
            };

            // Local time, not UTC -- a raw "...Z"-suffixed UTC instant reads as noise and is easy
            // to miss entirely (that's exactly what happened before this existed).
            function formatLocalDateTime(date) {
                return date.toLocaleString(undefined, {
                    month: '2-digit', day: '2-digit', year: 'numeric',
                    hour: '2-digit', minute: '2-digit', second: '2-digit'
                });
            }

            function formatDuration(elapsedMs) {
                const totalSeconds = Math.max(0, Math.floor(elapsedMs / 1000));
                const hours = Math.floor(totalSeconds / 3600);
                const minutes = Math.floor((totalSeconds % 3600) / 60);
                const seconds = totalSeconds % 60;
                const pad = function (n) { return String(n).padStart(2, '0'); };
                return hours > 0
                    ? hours + ':' + pad(minutes) + ':' + pad(seconds)
                    : minutes + ':' + pad(seconds);
            }

            // Fills in the local-time labels for a row's raw-UTC data attributes -- used both to
            // hydrate server-rendered rows on load and (with a fixed "now") to freeze a row's
            // duration once its call has ended.
            function hydrateRowTimestamps(row, now) {
                const startedLabel = row.querySelector('[data-started-label]');
                if (startedLabel && row.dataset.startedAt) {
                    startedLabel.textContent = formatLocalDateTime(new Date(row.dataset.startedAt));
                }

                const lastActivityEl = row.querySelector('[data-last-activity]');
                if (lastActivityEl) {
                    const iso = lastActivityEl.getAttribute('data-last-activity');
                    if (iso) {
                        lastActivityEl.textContent = 'Last activity ' + formatLocalDateTime(new Date(iso));
                    }
                }

                if (!row.classList.contains('ended') && row.dataset.startedAt) {
                    const durationEl = row.querySelector('[data-duration]');
                    if (durationEl) {
                        durationEl.textContent = formatDuration((now || new Date()) - new Date(row.dataset.startedAt));
                    }
                }
            }

            function sideBadge(side) {
                const normalized = (side || '').toLowerCase();
                const cls = normalized === 'agent' ? 'side-agent' : 'side-external';
                const label = normalized === 'agent' ? 'Agent' : 'External';
                const span = document.createElement('span');
                span.className = 'side-badge ' + cls;
                span.textContent = label;
                return span;
            }

            function transcriptTimeLabel(callElapsedMs) {
                const span = document.createElement('span');
                span.className = 'transcript-line-time';
                span.textContent = typeof callElapsedMs === 'number' ? '[' + formatDuration(callElapsedMs) + ']' : '';
                return span;
            }

            function appendTranscriptLine(line) {
                const row = document.createElement('div');
                row.className = 'transcript-line';
                row.appendChild(transcriptTimeLabel(line.callElapsedMs));
                row.appendChild(sideBadge(line.side));
                row.appendChild(document.createTextNode(line.text || ''));
                transcriptEl.appendChild(row);
                transcriptEl.scrollTop = transcriptEl.scrollHeight;
            }

            function appendEntityCard(notification) {
                const card = document.createElement('div');
                card.className = 'entity-card';

                const label = entityTypeLabels[notification.entityType] || notification.entityType;
                const title = document.createElement('div');
                title.appendChild(sideBadge(notification.sourceUtterance && notification.sourceUtterance.side));
                title.appendChild(document.createTextNode('Detected ' + label + ': ' + notification.canonicalValue));
                card.appendChild(title);

                const status = document.createElement('div');
                status.className = 'text-muted small';
                status.textContent = 'Validation: ' + (notification.validation ? notification.validation.status : 'unknown');
                card.appendChild(status);

                if (notification.actions && notification.actions.length) {
                    const actions = document.createElement('div');
                    actions.className = 'actions';
                    notification.actions.forEach(function (action) {
                        const span = document.createElement('span');
                        span.textContent = action.label;
                        actions.appendChild(span);
                    });
                    card.appendChild(actions);
                }

                entitiesEl.prepend(card);
            }

            // Builds or fully rebuilds one active-call row from a plain data object --
            // { callId, agentKey, startedAtUtc, lastActivityUtc, endedAtUtc }. Used both for a
            // brand-new call pushed via ActiveCallStarted (endedAtUtc always null there) and for
            // rebuilding a row from a server snapshot after a SignalR reconnect, where the real
            // startedAtUtc/endedAtUtc are already known.
            function buildOrUpdateCallRow(call) {
                let row = activeCallsEl.querySelector('[data-call-id="' + CSS.escape(call.callId) + '"]');
                const emptyRow = activeCallsEl.querySelector('[data-empty-row]');
                if (emptyRow) {
                    emptyRow.remove();
                }

                if (!row) {
                    row = document.createElement('button');
                    row.type = 'button';
                    row.className = 'call-row';
                    row.dataset.callId = call.callId;
                    row.addEventListener('click', function () { selectCall(call.callId); });
                    activeCallsEl.prepend(row);
                }

                row.dataset.agentKey = call.agentKey || '';
                row.dataset.startedAt = call.startedAtUtc;
                row.classList.toggle('ended', !!call.endedAtUtc);
                row.classList.toggle('selected', selectedCallId === call.callId);

                row.innerHTML = '';
                const strong = document.createElement('strong');
                strong.textContent = call.agentKey || '(unknown agent)';
                row.appendChild(strong);

                if (call.endedAtUtc) {
                    endedCallIds.add(call.callId);
                    row.appendChild(endedBadge());
                }

                const callIdLine = document.createElement('span');
                callIdLine.className = 'text-muted small d-block';
                callIdLine.textContent = call.callId;
                row.appendChild(callIdLine);

                const startedLine = document.createElement('span');
                startedLine.className = 'text-muted small d-block';
                startedLine.appendChild(document.createTextNode('Started '));
                const startedLabel = document.createElement('span');
                startedLabel.setAttribute('data-started-label', '');
                startedLabel.textContent = formatLocalDateTime(new Date(call.startedAtUtc));
                startedLine.appendChild(startedLabel);
                startedLine.appendChild(document.createTextNode(' · '));
                const durationEl = document.createElement('span');
                durationEl.setAttribute('data-duration', '');
                const durationEnd = call.endedAtUtc ? new Date(call.endedAtUtc) : new Date();
                durationEl.textContent = formatDuration(durationEnd - new Date(call.startedAtUtc));
                startedLine.appendChild(durationEl);
                row.appendChild(startedLine);

                const lastActivityIso = call.lastActivityUtc || new Date().toISOString();
                const lastActivity = document.createElement('span');
                lastActivity.className = 'text-muted small d-block';
                lastActivity.setAttribute('data-last-activity', lastActivityIso);
                lastActivity.textContent = 'Last activity ' + formatLocalDateTime(new Date(lastActivityIso));
                row.appendChild(lastActivity);

                return row;
            }

            function upsertActiveCallRow(callId, agentKey) {
                const nowIso = new Date().toISOString();
                buildOrUpdateCallRow({ callId, agentKey, startedAtUtc: nowIso, lastActivityUtc: nowIso, endedAtUtc: null });
            }

            // Rebuilds the whole "Active calls" list from a server snapshot -- used after a
            // SignalR reconnect, since any ActiveCallStarted/CallEnded broadcast that fired while
            // disconnected is otherwise lost for good (SignalR doesn't replay missed events).
            function rebuildActiveCallsList(calls) {
                const currentIds = new Set(calls.map(function (c) { return c.callId; }));
                activeCallsEl.querySelectorAll('.call-row').forEach(function (row) {
                    if (!currentIds.has(row.dataset.callId)) {
                        row.remove();
                    }
                });

                if (calls.length === 0) {
                    if (!activeCallsEl.querySelector('[data-empty-row]')) {
                        const empty = document.createElement('p');
                        empty.className = 'text-muted small';
                        empty.setAttribute('data-empty-row', '');
                        empty.textContent = activeCallsEl.dataset.emptyText;
                        activeCallsEl.appendChild(empty);
                    }
                    return;
                }

                calls.forEach(buildOrUpdateCallRow);
            }

            function endedBadge() {
                const span = document.createElement('span');
                span.className = 'ov-badge ov-badge-off call-ended-badge';
                span.textContent = 'Ended';
                return span;
            }

            // Marks a call ended in place -- deliberately does NOT remove the row or close the
            // detail panel, so an admin already reading a call's transcript keeps it (the whole
            // point of this signal is "stop looking active", not "disappear").
            function markActiveCallRowEnded(callId) {
                endedCallIds.add(callId);

                const row = activeCallsEl.querySelector('[data-call-id="' + CSS.escape(callId) + '"]');
                if (row && !row.classList.contains('ended')) {
                    // One last duration update with the real end instant, before the 'ended'
                    // class makes hydrateRowTimestamps/the tick interval stop touching it.
                    hydrateRowTimestamps(row, new Date());
                    row.classList.add('ended');
                    row.querySelector('strong').insertAdjacentElement('afterend', endedBadge());
                }

                if (selectedCallId === callId) {
                    updateSelectedCallMeta(new Date());
                    if (!callDetailHeadingEl.querySelector('.call-ended-badge')) {
                        callDetailHeadingEl.appendChild(endedBadge());
                    }
                }
            }

            // Renders/ticks the "Started ... · duration" line under the detail heading for
            // whichever call is currently selected. Stops updating (via data-frozen) once that
            // call's row is marked ended, same as hydrateRowTimestamps stops for the row itself.
            function updateSelectedCallMeta(now) {
                if (!selectedCallId) {
                    return;
                }

                const row = activeCallsEl.querySelector('[data-call-id="' + CSS.escape(selectedCallId) + '"]');
                if (!row || !row.dataset.startedAt || callDetailMetaEl.dataset.frozen === 'true') {
                    return;
                }

                const started = new Date(row.dataset.startedAt);
                callDetailMetaEl.textContent =
                    'Started ' + formatLocalDateTime(started) + ' · ' + formatDuration((now || new Date()) - started);

                if (row.classList.contains('ended')) {
                    callDetailMetaEl.dataset.frozen = 'true';
                }
            }

            // Resets and (re)populates the transcript/entities panels for whichever call is
            // selected, from a fresh GetSnapshot fetch. Used both for a first-time selection and
            // to re-sync after a SignalR reconnect (JoinCall's group membership is lost on
            // reconnect, and anything broadcast while disconnected is gone for good, so this is
            // the only way to backfill it).
            function loadCallDetail(callId) {
                transcriptEl.innerHTML = '';
                entitiesEl.innerHTML = '';
                callDetailHeadingEl.textContent = 'Loading…';

                fetch('@Url.Action("GetSnapshot", "AdminCallMonitor", new { callId = "__callId__" })'.replace('__callId__', encodeURIComponent(callId)))
                    .then(function (response) { return response.json(); })
                    .then(function (snapshot) {
                        if (selectedCallId !== callId) {
                            return;
                        }
                        callDetailHeadingEl.textContent = (snapshot.agentKey || '(unknown agent)') + ' — ' + snapshot.callId;
                        if (endedCallIds.has(callId)) {
                            callDetailHeadingEl.appendChild(endedBadge());
                        }
                        (snapshot.lines || []).forEach(appendTranscriptLine);
                    })
                    .catch(function () {
                        callDetailHeadingEl.textContent = callId;
                    });
            }

            function selectCall(callId) {
                if (selectedCallId === callId) {
                    return;
                }

                if (selectedCallId) {
                    connection.invoke('LeaveCall', selectedCallId).catch(function () { });
                }

                selectedCallId = callId;
                activeCallsEl.querySelectorAll('.call-row').forEach(function (row) {
                    row.classList.toggle('selected', row.dataset.callId === callId);
                });

                delete callDetailMetaEl.dataset.frozen;
                updateSelectedCallMeta(new Date());

                noCallSelectedEl.hidden = true;
                callDetailEl.hidden = false;

                connection.invoke('JoinCall', callId).catch(function () { });
                loadCallDetail(callId);
            }

            activeCallsEl.querySelectorAll('.call-row').forEach(function (row) {
                row.addEventListener('click', function () { selectCall(row.dataset.callId); });
                if (row.classList.contains('ended')) {
                    endedCallIds.add(row.dataset.callId);
                }
                hydrateRowTimestamps(row, new Date());
            });

            // Ticks every active row's duration (and the selected call's meta line) once a
            // second. Rows/the meta line stop being touched once ended (see hydrateRowTimestamps/
            // updateSelectedCallMeta) -- this just keeps calling both, cheaply, for everything.
            setInterval(function () {
                const now = new Date();
                activeCallsEl.querySelectorAll('.call-row:not(.ended)').forEach(function (row) {
                    hydrateRowTimestamps(row, now);
                });
                updateSelectedCallMeta(now);
            }, 1000);

            const connection = new signalR.HubConnectionBuilder()
                .withUrl('/hubs/call-monitor')
                .withAutomaticReconnect()
                .build();

            // .withAutomaticReconnect() only restores the transport -- it does NOT restore
            // per-call SignalR group membership (CallMonitorHub tracks that entirely client-side,
            // via JoinCall) and any broadcast that fired while disconnected is gone for good.
            // Mirrors RingCentralCallerTray's SignalR client: just re-invoke whatever
            // state-establishing calls were made at connect time.
            connection.onreconnected(function () {
                fetch('@Url.Action("GetActiveCalls", "AdminCallMonitor")')
                    .then(function (response) { return response.json(); })
                    .then(rebuildActiveCallsList)
                    .catch(function () { });

                if (selectedCallId) {
                    connection.invoke('JoinCall', selectedCallId).catch(function () { });
                    loadCallDetail(selectedCallId);
                }
            });

            connection.on('ActiveCallStarted', function (payload) {
                upsertActiveCallRow(payload.callId, payload.agentKey);
            });

            connection.on('CallEnded', function (payload) {
                markActiveCallRowEnded(payload.callId);
            });

            connection.on('TranscriptLineAppended', function (payload) {
                if (payload.callId === selectedCallId) {
                    appendTranscriptLine(payload);
                }
            });

            connection.on('EntityDetected', function (notification) {
                if (notification.callId === selectedCallId) {
                    appendEntityCard(notification);
                }
            });

            connection.start().catch(function (err) {
                console.error('Live Call Monitor connection failed to start.', err);
            });
        })();
    </script>
    <script>
        (function () {
            const agentKeyEl = document.getElementById('override-agent-key');
            const statusEl = document.getElementById('override-status');
            const checkBtn = document.getElementById('override-check');
            const ingestionMinutesEl = document.getElementById('override-ingestion-minutes');
            const ingestionEnableBtn = document.getElementById('override-ingestion-enable');
            const ingestionClearBtn = document.getElementById('override-ingestion-clear');
            const deliveryMinutesEl = document.getElementById('override-delivery-minutes');
            const deliveryMirrorEl = document.getElementById('override-delivery-mirror');
            const deliveryEnableBtn = document.getElementById('override-delivery-enable');
            const deliveryClearBtn = document.getElementById('override-delivery-clear');
            const activeOverridesListEl = document.getElementById('active-overrides-list');
            const activeOverridesRefreshBtn = document.getElementById('active-overrides-refresh');
            const activeOverridesIntervalEl = document.getElementById('active-overrides-interval');

            function currentAgentKey() {
                return (agentKeyEl.value || '').trim();
            }

            function formatExpiry(iso) {
                if (!iso) {
                    return '';
                }
                const date = new Date(iso);
                return ' (until ' + date.toISOString().replace('T', ' ').slice(0, 19) + ' UTC)';
            }

            // Compact "MM/dd HH:mm UTC" for the Active Overrides side panel, where the badge label
            // ("Ingestion"/"Delivery") already gives context -- the full formatExpiry() wording is
            // for the single-agent status line above, which has the room for it.
            function formatExpiryShort(iso) {
                if (!iso) {
                    return '';
                }
                const date = new Date(iso);
                const pad = function (n) { return String(n).padStart(2, '0'); };
                return pad(date.getUTCMonth() + 1) + '/' + pad(date.getUTCDate()) + ' ' +
                    pad(date.getUTCHours()) + ':' + pad(date.getUTCMinutes()) + ' UTC';
            }

            function renderStatus(settings) {
                if (!settings) {
                    statusEl.textContent = 'Unable to reach the Call Data API.';
                    return;
                }

                const parts = [
                    'Real opt-in: ' + (settings.showAiPrompts ? 'ON' : 'OFF'),
                    'Ingestion override: ' + (settings.ingestionOverrideActive
                        ? 'active' + formatExpiry(settings.ingestionOverrideExpiresAtUtc)
                        : 'inactive'),
                    'Delivery override: ' + (settings.deliveryOverrideActive
                        ? 'active' + formatExpiry(settings.deliveryOverrideExpiresAtUtc) +
                          (settings.deliveryMirrorAgentKey ? ' — mirrored to ' + settings.deliveryMirrorAgentKey : '')
                        : 'inactive')
                ];

                if (settings.showAiPrompts) {
                    parts.push(settings.deliveryOverrideActive && settings.deliveryMirrorAgentKey
                        ? 'Real opt-in is already ON — this agent gets it directly, and ' + settings.deliveryMirrorAgentKey + ' still gets the mirrored copy too.'
                        : 'Real opt-in is already ON — both overrides are currently redundant; this agent already gets full delivery.');
                }

                statusEl.textContent = parts.join(' | ');
            }

            function withAgentKey(action) {
                const agentKey = currentAgentKey();
                if (!agentKey) {
                    statusEl.textContent = 'Enter an agent key first.';
                    return;
                }
                action(agentKey);
            }

            function checkStatus(agentKey) {
                statusEl.textContent = 'Checking…';
                fetch('@Url.Action("GetOverrides", "AdminCallMonitor")?agentKey=' + encodeURIComponent(agentKey))
                    .then(function (response) { return response.ok ? response.json() : null; })
                    .then(renderStatus)
                    .catch(function () { renderStatus(null); });
            }

            function postOverride(url, agentKey, extraFields) {
                const body = new URLSearchParams({ agentKey: agentKey });
                Object.keys(extraFields || {}).forEach(function (key) {
                    if (extraFields[key] !== undefined && extraFields[key] !== null && extraFields[key] !== '') {
                        body.set(key, extraFields[key]);
                    }
                });

                statusEl.textContent = 'Updating…';
                fetch(url, { method: 'POST', body: body })
                    .then(function (response) { return response.ok ? response.json() : null; })
                    .then(function (settings) {
                        renderStatus(settings);
                        refreshActiveOverrides();
                    })
                    .catch(function () { renderStatus(null); });
            }

            function ovBadge(text, on) {
                const span = document.createElement('span');
                span.className = 'ov-badge ' + (on ? 'ov-badge-on' : 'ov-badge-off');
                span.textContent = text;
                return span;
            }

            function ovLine(badgeText, badgeOn, expiryText) {
                const line = document.createElement('div');
                line.className = 'ov-line';
                line.appendChild(ovBadge(badgeText, badgeOn));
                if (expiryText) {
                    const expiry = document.createElement('span');
                    expiry.className = 'ov-expiry';
                    expiry.textContent = 'until ' + expiryText;
                    line.appendChild(expiry);
                }
                return line;
            }

            function renderActiveOverrides(list) {
                activeOverridesListEl.innerHTML = '';

                if (!list) {
                    activeOverridesListEl.textContent = 'Unable to reach the Call Data API.';
                    return;
                }
                if (!list.length) {
                    activeOverridesListEl.textContent = 'No active overrides.';
                    return;
                }

                list.forEach(function (item) {
                    const row = document.createElement('div');
                    row.className = 'active-override-row';

                    const header = document.createElement('div');
                    header.className = 'active-override-header';
                    const strong = document.createElement('strong');
                    strong.textContent = item.agentKey;
                    header.appendChild(strong);

                    const loadBtn = document.createElement('button');
                    loadBtn.type = 'button';
                    loadBtn.textContent = 'Edit';
                    loadBtn.addEventListener('click', function () {
                        agentKeyEl.value = item.agentKey;
                        checkStatus(item.agentKey);
                    });
                    header.appendChild(loadBtn);
                    row.appendChild(header);

                    row.appendChild(ovLine('Opt-in ' + (item.showAiPrompts ? 'ON' : 'OFF'), item.showAiPrompts));

                    if (item.ingestionOverrideActive) {
                        row.appendChild(ovLine('Ingestion', true, formatExpiryShort(item.ingestionOverrideExpiresAtUtc)));
                    }

                    if (item.deliveryOverrideActive) {
                        row.appendChild(ovLine('Delivery', true, formatExpiryShort(item.deliveryOverrideExpiresAtUtc)));
                        if (item.deliveryMirrorAgentKey) {
                            const mirror = document.createElement('div');
                            mirror.className = 'ov-mirror';
                            mirror.textContent = '→ ' + item.deliveryMirrorAgentKey;
                            row.appendChild(mirror);
                        }
                    }

                    activeOverridesListEl.appendChild(row);
                });
            }

            function refreshActiveOverrides() {
                fetch('@Url.Action("GetAllActiveOverrides", "AdminCallMonitor")')
                    .then(function (response) { return response.ok ? response.json() : null; })
                    .then(renderActiveOverrides)
                    .catch(function () { renderActiveOverrides(null); });
            }

            // Per-viewer preference only (which admin is watching, on which machine) -- not
            // shared/durable state, so localStorage is the right fit rather than a server setting.
            const REFRESH_INTERVAL_STORAGE_KEY = 'aitb.adminCallMonitor.activeOverridesRefreshMs';
            let activeOverridesTimer = null;

            function applyRefreshInterval(ms) {
                if (activeOverridesTimer !== null) {
                    clearInterval(activeOverridesTimer);
                    activeOverridesTimer = null;
                }
                if (ms > 0) {
                    activeOverridesTimer = setInterval(refreshActiveOverrides, ms);
                }
                try {
                    localStorage.setItem(REFRESH_INTERVAL_STORAGE_KEY, String(ms));
                } catch (e) { /* private browsing / storage blocked -- just skip persisting */ }
            }

            function loadStoredRefreshInterval() {
                try {
                    const stored = localStorage.getItem(REFRESH_INTERVAL_STORAGE_KEY);
                    if (stored !== null && activeOverridesIntervalEl.querySelector('option[value="' + stored + '"]')) {
                        return stored;
                    }
                } catch (e) { /* private browsing / storage blocked -- fall back to the default */ }
                return activeOverridesIntervalEl.value;
            }

            checkBtn.addEventListener('click', function () { withAgentKey(checkStatus); });

            ingestionEnableBtn.addEventListener('click', function () {
                withAgentKey(function (agentKey) {
                    postOverride('@Url.Action("SetIngestionOverride", "AdminCallMonitor")', agentKey, {
                        expiresInMinutes: ingestionMinutesEl.value
                    });
                });
            });
            ingestionClearBtn.addEventListener('click', function () {
                withAgentKey(function (agentKey) {
                    postOverride('@Url.Action("ClearIngestionOverride", "AdminCallMonitor")', agentKey);
                });
            });

            deliveryEnableBtn.addEventListener('click', function () {
                withAgentKey(function (agentKey) {
                    postOverride('@Url.Action("SetDeliveryOverride", "AdminCallMonitor")', agentKey, {
                        expiresInMinutes: deliveryMinutesEl.value,
                        mirrorToAgentKey: (deliveryMirrorEl.value || '').trim()
                    });
                });
            });
            deliveryClearBtn.addEventListener('click', function () {
                withAgentKey(function (agentKey) {
                    postOverride('@Url.Action("ClearDeliveryOverride", "AdminCallMonitor")', agentKey);
                    deliveryMirrorEl.value = '';
                });
            });

            activeOverridesRefreshBtn.addEventListener('click', refreshActiveOverrides);
            activeOverridesIntervalEl.addEventListener('change', function () {
                applyRefreshInterval(Number(activeOverridesIntervalEl.value));
            });

            refreshActiveOverrides();
            activeOverridesIntervalEl.value = loadStoredRefreshInterval();
            applyRefreshInterval(Number(activeOverridesIntervalEl.value));
        })();
    </script>
}
