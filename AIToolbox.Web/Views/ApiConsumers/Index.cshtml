@model IReadOnlyList<ApiConsumer>

@{
    ViewData["Title"] = "API Consumers";
}

<div class="page-heading">
    <div>
        <h1>API Consumers</h1>
        <p class="text-muted mb-0">Manage service principals and API keys for non-M365 consumers.</p>
    </div>
    <div class="page-actions">
        <a asp-action="Create" class="btn btn-primary">Add consumer</a>
    </div>
</div>

<div class="table-surface">
    <table class="table align-middle mb-0">
        <thead>
            <tr>
                <th>Name</th>
                <th>Owner</th>
                <th>Status</th>
                <th>Last Used</th>
                <th class="text-end">Actions</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var consumer in Model)
        {
            <tr>
                <td><strong>@consumer.Name</strong><div class="text-muted small">@consumer.Description</div></td>
                <td>@consumer.OwnerEmail</td>
                <td><span class="badge @(consumer.IsEnabled ? "text-bg-success" : "text-bg-secondary")">@(consumer.IsEnabled ? "Enabled" : "Disabled")</span></td>
                <td>@(consumer.LastUsedUtc?.ToLocalTime().ToString("g") ?? "Never")</td>
                <td class="text-end"><a asp-action="Detail" asp-route-id="@consumer.Id" class="btn btn-sm btn-outline-primary">Open</a></td>
            </tr>
        }
        </tbody>
    </table>
</div>
