@model ApiConsumerDetailViewModel

@{
    ViewData["Title"] = Model.Consumer.Name;
}

<div class="page-heading">
    <div>
        <h1>@Model.Consumer.Name</h1>
        <p class="text-muted mb-0">API consumer setup, keys, scopes, and status.</p>
    </div>
    <div class="page-actions">
        <a asp-action="Index" class="btn btn-outline-secondary">Back</a>
    </div>
</div>

<div class="row g-3">
    <div class="col-lg-5">
        <form asp-action="Update" asp-route-id="@Model.Consumer.Id" method="post" class="settings-panel">
            @Html.AntiForgeryToken()
            <input type="hidden" name="Id" value="@Model.Consumer.Id" />
            <div class="mb-3">
                <label class="form-label" for="Name">Name</label>
                <input id="Name" name="Name" value="@Model.Consumer.Name" class="form-control" />
            </div>
            <div class="mb-3">
                <label class="form-label" for="Description">Description</label>
                <textarea id="Description" name="Description" class="form-control" rows="3">@Model.Consumer.Description</textarea>
            </div>
            <div class="mb-3">
                <label class="form-label" for="OwnerEmail">Owner email</label>
                <input id="OwnerEmail" name="OwnerEmail" value="@Model.Consumer.OwnerEmail" class="form-control" />
            </div>
            <div class="form-check mb-3">
                <input id="IsEnabled" name="IsEnabled" value="true" class="form-check-input" type="checkbox" @(Model.Consumer.IsEnabled ? "checked" : "") />
                <input name="IsEnabled" value="false" type="hidden" />
                <label class="form-check-label" for="IsEnabled">Enabled</label>
            </div>
            <button type="submit" class="btn btn-primary">Save</button>
        </form>
    </div>
    <div class="col-lg-7">
        <form asp-action="CreateKey" asp-route-id="@Model.Consumer.Id" method="post" class="settings-panel mb-3">
            @Html.AntiForgeryToken()
            <input type="hidden" name="ApiConsumerId" value="@Model.Consumer.Id" />
            <h2 class="h5">Create key</h2>
            <div class="mb-3">
                <label class="form-label" for="Name">Name</label>
                <input id="Name" name="Name" value="@Model.NewKey.Name" class="form-control" />
            </div>
            <div class="mb-3">
                <label class="form-label" for="Scopes">Scopes</label>
                <input id="Scopes" name="Scopes" value="@Model.NewKey.Scopes" class="form-control" />
                <div class="form-text">Space, comma, or line separated scopes. Click a scope below to add it.</div>
                <div class="scope-picker mt-2">
                    @foreach (var scope in Model.AvailableScopes)
                    {
                        <button type="button" class="btn btn-outline-secondary btn-sm scope-chip" data-scope="@scope.Value" title="@scope.Description">@scope.Value</button>
                    }
                </div>
                <details class="scope-legend mt-2">
                    <summary class="text-muted small">What does each scope grant?</summary>
                    <dl class="scope-legend-list mb-0">
                        @foreach (var scope in Model.AvailableScopes)
                        {
                            <dt>@scope.Value</dt>
                            <dd>@scope.Description</dd>
                        }
                    </dl>
                </details>
            </div>
            <div class="mb-3">
                <label class="form-label" for="ExpiresUtc">Expires UTC</label>
                <input id="ExpiresUtc" name="ExpiresUtc" value="@(Model.NewKey.ExpiresUtc?.ToString("s"))" class="form-control" type="datetime-local" />
            </div>
            <button type="submit" class="btn btn-primary">Generate key</button>
        </form>

        <div class="table-surface">
            <table class="table align-middle mb-0">
                <thead>
                    <tr>
                        <th>Key</th>
                        <th>Scopes</th>
                        <th>Status</th>
                        <th>Last Used</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var key in Model.Consumer.Keys)
                {
                    <tr>
                        <td><strong>@key.Name</strong><div class="text-muted small">@key.KeyPrefix...</div></td>
                        <td class="small">@key.ScopesJson</td>
                        <td><span class="badge @(key.IsActive ? "text-bg-success" : "text-bg-secondary")">@(key.IsActive ? "Active" : "Inactive")</span></td>
                        <td>@(key.LastUsedUtc?.ToLocalTime().ToString("g") ?? "Never")</td>
                        <td class="text-end">
                            @if (key.RevokedUtc is null)
                            {
                                <form asp-action="RevokeKey" asp-route-keyId="@key.Id" method="post">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="consumerId" value="@Model.Consumer.Id" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger">Revoke</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
</div>

<style>
    .scope-picker {
        display: flex;
        flex-wrap: wrap;
        gap: 0.35rem;
    }

    .scope-chip {
        font-family: var(--bs-font-monospace, monospace);
        font-size: 0.75rem;
    }

    .scope-chip.added {
        background-color: var(--bs-success, #198754);
        color: #fff;
        border-color: var(--bs-success, #198754);
    }

    .scope-legend summary {
        cursor: pointer;
    }

    .scope-legend-list {
        margin-top: 0.5rem;
        margin-left: 0.25rem;
    }

    .scope-legend-list dt {
        font-family: var(--bs-font-monospace, monospace);
        font-size: 0.8rem;
        font-weight: 600;
        margin-top: 0.5rem;
    }

    .scope-legend-list dd {
        color: var(--bs-secondary-color, #6c757d);
        font-size: 0.8rem;
        margin-left: 0;
        margin-bottom: 0;
    }
</style>

@section Scripts {
    <script>
        (function () {
            const scopesInput = document.getElementById('Scopes');

            // Same delimiter set ApiConsumersController.ParseScopes splits on server-side --
            // keeps the dedupe check here consistent with what actually gets saved.
            function currentScopes() {
                return (scopesInput.value || '')
                    .split(/[\s,;]+/)
                    .filter(function (s) { return s.length > 0; });
            }

            function refreshChipState() {
                const existing = currentScopes().map(function (s) { return s.toLowerCase(); });
                document.querySelectorAll('.scope-chip').forEach(function (button) {
                    button.classList.toggle('added', existing.includes(button.dataset.scope.toLowerCase()));
                });
            }

            document.querySelectorAll('.scope-chip').forEach(function (button) {
                button.addEventListener('click', function () {
                    const scope = button.dataset.scope;
                    const existing = currentScopes();

                    if (!existing.some(function (s) { return s.toLowerCase() === scope.toLowerCase(); })) {
                        existing.push(scope);
                        scopesInput.value = existing.join(' ');
                    }

                    refreshChipState();
                });
            });

            scopesInput.addEventListener('input', refreshChipState);
            refreshChipState();
        })();
    </script>
}
