@model RetentionSettingsFormViewModel

@{
    ViewData["Title"] = "Retention Settings";
}

<div class="page-heading">
    <div>
        <h1>Retention Settings</h1>
        <p class="text-muted mb-0">Full chat conversation transcripts are deleted this many days after a conversation closes. Usage/spend statistics are kept indefinitely regardless of this setting.</p>
    </div>
</div>

@if (TempData["StatusMessage"] is string statusMessage)
{
    <div class="alert alert-success">@statusMessage</div>
}

<form method="post" class="tool-surface">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="mb-3">
        <label asp-for="ConversationRetentionDays" class="form-label"></label>
        <input asp-for="ConversationRetentionDays" class="form-control" style="max-width: 200px;" />
        <span asp-validation-for="ConversationRetentionDays" class="text-danger"></span>
    </div>

    <div class="form-actions">
        <button type="submit" class="btn btn-primary">Save</button>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
