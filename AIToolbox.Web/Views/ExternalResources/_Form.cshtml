@model ExternalResourceFormViewModel

<div class="alert alert-info" data-resource-type-help="AzureSpeech" style="@(Model.ResourceType == ExternalResourceType.AzureSpeech ? "" : "display:none;")">
    <strong>Set this up in the Azure Portal first:</strong>
    <ol class="mb-0">
        <li>Azure Portal &rarr; Create a resource &rarr; search <strong>"Speech"</strong> &rarr; create it (Free F0 tier is fine for light use).</li>
        <li>Note the <strong>Region</strong> you picked when creating it.</li>
        <li>Once deployed &rarr; <strong>Keys and Endpoint</strong> &rarr; copy <strong>KEY 1</strong>.</li>
        <li>Paste the region and key below and Save.</li>
    </ol>
</div>

<div class="alert alert-info" data-resource-type-help="CallDataApi" style="@(Model.ResourceType == ExternalResourceType.CallDataApi ? "" : "display:none;")">
    <strong>The Call Data API is owned by a separate team.</strong>
    <ol class="mb-0">
        <li>Get the base URL and a bearer credential from the team that owns the Call Data API.</li>
        <li>Paste the base URL and credential below and Save.</li>
    </ol>
    <p class="mb-0">See <code>AIToolbox/TODO_Lists/call-data-api-contract.md</code> for the wire contract this integration uses.</p>
</div>

<form method="post" class="tool-surface">
    @Html.AntiForgeryToken()
    <input asp-for="Id" type="hidden" />
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="form-grid">
        <div class="mb-3">
            <label asp-for="ResourceType" class="form-label"></label>
            @* Explicit options (not Html.GetEnumSelectList, whose option values are the enum's
               numeric string form) so the toggle script below can match on the readable name
               that data-resource-type-field/-help also use. Enum's name-string form still binds
               correctly on POST via the built-in enum model binder. *@
            <select asp-for="ResourceType" class="form-select" id="resourceTypeSelect">
                <option value="@ExternalResourceType.AzureSpeech" selected="@(Model.ResourceType == ExternalResourceType.AzureSpeech)">Azure Speech-to-Text</option>
                <option value="@ExternalResourceType.CallDataApi" selected="@(Model.ResourceType == ExternalResourceType.CallDataApi)">Call Data API</option>
            </select>
            <span asp-validation-for="ResourceType" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="DisplayName" class="form-label"></label>
            <input asp-for="DisplayName" class="form-control" />
            <span asp-validation-for="DisplayName" class="text-danger"></span>
        </div>

        <div class="mb-3" data-resource-type-field="AzureSpeech" style="@(Model.ResourceType == ExternalResourceType.AzureSpeech ? "" : "display:none;")">
            <label asp-for="Region" class="form-label"></label>
            <input asp-for="Region" class="form-control" placeholder="eastus" />
            <span asp-validation-for="Region" class="text-danger"></span>
            <div class="form-text">The region you chose when creating the Speech resource in Azure.</div>
        </div>

        <div class="mb-3" data-resource-type-field="AzureSpeech" style="@(Model.ResourceType == ExternalResourceType.AzureSpeech ? "" : "display:none;")">
            <label asp-for="Language" class="form-label"></label>
            <select asp-for="Language" class="form-select">
                <option value="en-US">English (United States)</option>
                <option value="en-GB">English (United Kingdom)</option>
                <option value="es-ES">Spanish (Spain)</option>
                <option value="es-MX">Spanish (Mexico)</option>
                <option value="fr-FR">French (France)</option>
                <option value="de-DE">German (Germany)</option>
                @if (!new[] { "en-US", "en-GB", "es-ES", "es-MX", "fr-FR", "de-DE" }.Contains(Model.Language))
                {
                    <option value="@Model.Language" selected>@Model.Language</option>
                }
            </select>
            <span asp-validation-for="Language" class="text-danger"></span>
        </div>

        <div class="mb-3 wide" data-resource-type-field="CallDataApi" style="@(Model.ResourceType == ExternalResourceType.CallDataApi ? "" : "display:none;")">
            <label asp-for="BaseUrl" class="form-label"></label>
            <input asp-for="BaseUrl" class="form-control" placeholder="https://calldata.example.com" />
            <span asp-validation-for="BaseUrl" class="text-danger"></span>
        </div>

        <div class="mb-3 wide">
            <label asp-for="SubscriptionKey" class="form-label"></label>
            <input asp-for="SubscriptionKey" class="form-control" autocomplete="off" />
            <span asp-validation-for="SubscriptionKey" class="text-danger"></span>
            @if (Model.HasStoredSecret)
            {
                <div class="form-text">A key is currently stored.</div>
            }
        </div>
    </div>

    <div class="switch-row">
        <div class="form-check form-switch">
            <input asp-for="IsEnabled" class="form-check-input" />
            <label asp-for="IsEnabled" class="form-check-label"></label>
        </div>
        @if (Model.Id > 0)
        {
            <div class="form-check form-switch">
                <input asp-for="ClearSecret" class="form-check-input" />
                <label asp-for="ClearSecret" class="form-check-label"></label>
            </div>
        }
    </div>

    <div class="form-actions">
        <a asp-action="Index" class="btn btn-outline-secondary">Back</a>
        <button type="submit" class="btn btn-primary">Save resource</button>
    </div>
</form>

<script>
    (function () {
        var select = document.getElementById('resourceTypeSelect');
        if (!select) {
            return;
        }

        function applyResourceType() {
            var selected = select.value;
            document.querySelectorAll('[data-resource-type-field]').forEach(function (el) {
                el.style.display = el.getAttribute('data-resource-type-field') === selected ? '' : 'none';
            });
            document.querySelectorAll('[data-resource-type-help]').forEach(function (el) {
                el.style.display = el.getAttribute('data-resource-type-help') === selected ? '' : 'none';
            });
        }

        select.addEventListener('change', applyResourceType);
    })();
</script>
