{
  "ConnectionStrings": {
    "AITools": "Server=YOUR_SQL_SERVER;Database=AITools;Trusted_Connection=True;MultipleActiveResultSets=true;TrustServerCertificate=True"
  },
  "Database": {
    "InitializeOnStartup": true
  },
  "DataProtection": {
    "ApplicationName": "AIToolsCompare",
    "KeysPath": ""
  },
  "AIToolsLogging": {
    "BasePath": "C:\\inetpub\\logs\\SiteLogs\\stdair.com_aitools",
    "RetainedFileCountLimit": 31,
    "FileSizeLimitBytes": 52428800
  },
  "Storage": {
    "BasePath": "",
    "MaxUploadBytes": 15728640,
    "ToolSubpaths": {
      "ProductParser": "ProductParser"
    }
  },
  "Cors": {
    "ChromeExtensionOrigins": []
  },
  "MicrosoftEntra": {
    "Instance": "https://login.microsoftonline.com/",
    "TenantId": "common",
    "ClientId": "YOUR_ENTRA_APP_CLIENT_ID",
    "ClientSecret": "DO_NOT_STORE_REAL_SECRETS_HERE",
    "CallbackPath": "/signin-oidc",
    "ApiAudience": "api://YOUR_AITOOLS_API_APP_ID",
    "ApiScope": "AITools.Access",
    "AllowedTenantIds": [
      "KOCH_AIR_TENANT_ID",
      "STANDARD_AIR_TENANT_ID"
    ],
    "AllowedDomains": [
      "kochair.com",
      "stdair.com"
    ],
    "EnableAutoProvisioning": true,
    "BootstrapAdminEmails": [
      "itadmin@stdair.com"
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
