# The Chrome extension's permanent signing key -- generated exactly once (see
# AIToolbox.ChromeExtension/publish/README.md); never commit it, back it up externally instead.
AIToolbox.ChromeExtension/publish/*.pem
AIToolbox.ChromeExtension/publish/output/
AIToolbox.ChromeExtension/publish/stage/

# Keep appsettings.json as a placeholder only. Put real values in ignored
# environment-specific files, IIS settings, user secrets, or a secret store.
**/appsettings.*.json
!**/appsettings.Development.json
!**/appsettings.example.json
