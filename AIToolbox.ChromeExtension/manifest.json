{
  "manifest_version": 3,
  "name": "AI Toolbox",
  "description": "Upload vendor PDFs to AI Toolbox and recall parsed product data.",
  "version": "0.4.1",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["alarms", "identity", "notifications", "sidePanel", "storage", "tabs"],
  "host_permissions": ["https://*/", "http://localhost/*", "https://localhost/*"],
  "background": {
    "service_worker": "dist/background.js",
    "type": "module"
  },
  "action": {
    "default_title": "AI Toolbox",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": ["https://crm.zoho.com/crm/*"],
      "js": ["dist/zoho-crm-content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://p21web.stdair.com/prophet21*"],
      "js": ["dist/p21-content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://app.p21toolbox.com/*"],
      "js": ["dist/pic-search-content.js"],
      "all_frames": true,
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["icons/icon-32.png"],
      "matches": ["https://crm.zoho.com/*", "https://p21web.stdair.com/*"]
    }
  ],
  "options_page": "options.html"
}
